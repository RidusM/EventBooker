APP_NAME=ebooker
APP_VERSION=1.0.0
ENV=local

HTTP_HOST=0.0.0.0
HTTP_IDLE_TIMEOUT=60s
HTTP_MAX_HEADER_BYTES=1048576
HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=5s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=5s

DB_BASE_RETRY_DELAY=100ms
DB_CONN_ATTEMPTS=5
DB_DSN=postgres://postgres:postgres@db:5432/ebooker_db?sslmode=disable
DB_HOST=db
DB_MAX_RETRY_DELAY=5s
DB_NAME=ebooker_db
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_PORT=5432
DB_SSL_MODE=disable
DB_USER=postgres

SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USERNAME=

TG_ALIAS=ebookerGolang_bot
TG_TOKEN=

SERIVCE_BOOK_EVENT_TTL=15

LOGGER_FILENAME=./logs/ebooker.log
LOGGER_LEVEL=info
LOGGER_MAX_AGE=28
LOGGER_MAX_BACKUPS=3
LOGGER_MAX_SIZE=100
